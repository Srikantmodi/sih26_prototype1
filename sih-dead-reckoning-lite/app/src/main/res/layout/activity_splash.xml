<?xml version="1.0" encoding="utf-8"?>
<!-- Splash Screen Layout — Matches splash_dr_lite_horizon reference -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/surface_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="24dp">

        <!-- ISRO Badge Chip -->
        <TextView
            android:id="@+id/isro_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_chip"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="@string/isro_badge"
            android:textColor="@color/secondary_dark"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textAllCaps="true"
            android:letterSpacing="0.08"
            android:drawableStart="@drawable/dot_gnss"
            android:drawablePadding="8dp" />

        <!-- DR LITE Title -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/splash_title_dr"
                android:textColor="@color/on_surface_dark"
                android:textSize="40sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/splash_title_lite"
                android:textColor="@color/primary_dark"
                android:textSize="40sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:letterSpacing="-0.02" />
        </LinearLayout>

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/app_subtitle"
            android:textColor="@color/on_surface_variant_dark"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:gravity="center" />

        <!-- Hardware Handshake Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp">

            <!-- Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/hardware_handshake"
                    android:textColor="@color/on_surface_variant_dark"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/hardware_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hardware_ready"
                    android:textColor="@color/primary_dark"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <!-- IMU Sensor Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_sensor_cell"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sensor_imu"
                    android:textColor="@color/on_surface_dark"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sync_ok"
                    android:textColor="@color/primary_dark"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <!-- GNSS Sensor Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_sensor_cell"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sensor_gnss"
                    android:textColor="@color/on_surface_dark"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sync_ok"
                    android:textColor="@color/primary_dark"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <!-- Magnetometer Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_sensor_cell"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/sensor_mag"
                    android:textColor="@color/on_surface_dark"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sync_ok"
                    android:textColor="@color/primary_dark"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <!-- Buffer Load Progress -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/buffer_load"
                    android:textColor="@color/on_surface_variant_dark"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/buffer_percent"
                    android:textColor="@color/on_surface_dark"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_buffer"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progress="100"
                android:progressDrawable="@android:drawable/progress_horizontal"
                android:indeterminate="false" />
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Initialize Console Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_initialize"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="@string/initialize_console"
            android:textColor="@color/on_primary_dark"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            app:backgroundTint="@color/primary_dark"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_media_play"
            app:iconGravity="end"
            app:iconTint="@color/on_primary_dark"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

    </LinearLayout>
</ScrollView>
