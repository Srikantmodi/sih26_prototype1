<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/surface">

	<org.osmdroid.views.MapView
		android:id="@+id/map_view"
		android:layout_width="match_parent"
		android:layout_height="match_parent" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="top"
		android:orientation="vertical"
		android:padding="16dp"
		android:background="@color/map_scrim">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:gravity="center_vertical"
			android:orientation="horizontal">

			<TextView
				android:id="@+id/mode_badge"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:background="@color/gnss_green"
				android:paddingStart="12dp"
				android:paddingTop="7dp"
				android:paddingEnd="12dp"
				android:paddingBottom="7dp"
				android:text="@string/mode_gnss"
				android:textColor="@android:color/white"
				android:textSize="12sp"
				android:textStyle="bold" />

			<Space
				android:layout_width="0dp"
				android:layout_height="1dp"
				android:layout_weight="1" />

			<Switch
				android:id="@+id/tunnel_switch"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/simulate_tunnel"
				android:textColor="@color/ink" />
		</LinearLayout>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:text="@string/map_attribution"
			android:textColor="@color/muted_text"
			android:textSize="11sp" />
	</LinearLayout>

	<LinearLayout
		android:id="@+id/telemetry_panel"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_gravity="bottom"
		android:background="@color/surface_elevated"
		android:elevation="8dp"
		android:orientation="vertical"
		android:padding="18dp">

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/telemetry_title"
			android:textColor="@color/muted_text"
			android:textSize="11sp"
			android:textStyle="bold" />

		<TextView
			android:id="@+id/position_text"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:text="@string/waiting_for_location"
			android:textColor="@color/ink"
			android:textSize="15sp"
			android:fontFamily="monospace" />

		<TextView
			android:id="@+id/accel_text"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/waiting_for_sensor"
			android:textColor="@color/ink"
			android:textSize="14sp"
			android:fontFamily="monospace" />

		<TextView
			android:id="@+id/gyro_text"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/waiting_for_sensor"
			android:textColor="@color/ink"
			android:textSize="14sp"
			android:fontFamily="monospace" />

		<TextView
			android:id="@+id/drift_text"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Drift  0.0 m"
			android:textColor="@color/dead_reckoning_amber"
			android:textSize="14sp"
			android:fontFamily="monospace" />
	</LinearLayout>
</FrameLayout>
