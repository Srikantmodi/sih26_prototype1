<?xml version="1.0" encoding="utf-8"?>
<!-- Drive Log History — Matches drive_log_history_dr_lite_horizon reference -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- ===== Header Bar ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="?attr/colorSurface"
        android:elevation="2dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/drive_log_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:maxLines="2" />

        <!-- DR Active Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot_gnss" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/dr_active"
                android:textColor="?attr/colorSecondary"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <!-- Theme Toggle -->
        <ImageButton
            android:id="@+id/btn_theme_toggle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_day"
            android:contentDescription="@string/cd_theme_toggle"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>

    <!-- ===== Stats Summary Row ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:orientation="horizontal">

        <!-- Total Logs -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/total_logs"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:textAllCaps="true"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/stat_total_logs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0"
                android:textColor="?attr/colorOnSurface"
                android:textSize="22sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>

        <View android:layout_width="6dp" android:layout_height="1dp" />

        <!-- Storage -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/storage_label"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:textAllCaps="true"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/stat_storage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0 KB"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>

        <View android:layout_width="6dp" android:layout_height="1dp" />

        <!-- Time -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/time_label"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:textAllCaps="true"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/stat_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="00:00"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Search Bar ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:hint="@string/search_sessions_hint"
            android:textColorHint="?attr/colorOutline"
            android:textColor="?attr/colorOnSurface"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:inputType="text"
            android:maxLines="1"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:importantForAutofill="no" />

        <ImageButton
            android:id="@+id/btn_filter"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_card"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:contentDescription="@string/cd_filter"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>

    <!-- ===== Session Header ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="16dp"
        android:paddingBottom="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/recorded_sessions"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:textAllCaps="true"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sort_label"
            android:textColor="?attr/colorOutline"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:letterSpacing="0.05" />
    </LinearLayout>

    <!-- ===== Log List ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_logs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false" />

    <!-- ===== Empty State ===== -->
    <TextView
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/no_logs_found"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:lineSpacingMultiplier="1.4"
        android:visibility="gone" />

    <!-- ===== Action Buttons Row ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_export_all"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/sync_all_new"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            app:cornerRadius="8dp" />

        <View android:layout_width="8dp" android:layout_height="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_clear_cache"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/clear_cache"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- ===== Bottom Navigation ===== -->
    <include layout="@layout/layout_bottom_nav" />

</LinearLayout>
